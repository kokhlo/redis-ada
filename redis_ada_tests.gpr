with "redis_ada.gpr";

project Redis_Ada_Tests is
   for Source_Dirs use ("test");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("redis-resp2-tests.adb", "redis-connection-tests.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-O2");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;
end Redis_Ada_Tests;
